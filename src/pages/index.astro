---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Home">
	<section class="flex flex-col items-start gap-6 sm:flex-row sm:items-center">
		<img
			src="/avatar.jpg"
			alt="Portrait of Liz Tsalaja"
			class="h-44 w-44 rounded-full border border-stone-200 object-cover object-[50%_70%] dark:border-stone-800"
		/>
		<div>
			<h1 class="font-display text-4xl font-medium tracking-tight text-slate-900 dark:text-stone-100">
				Hi, I'm Liz.
			</h1>
			<p class="mt-2 text-lg text-slate-600 dark:text-stone-400">
				Fourth-year Math & Digital/Computational Studies student at Bates College.
			</p>
		</div>
	</section>

	<p class="mt-8 text-lg leading-relaxed text-slate-700 dark:text-stone-300">
		I like turning messy real-world questions into models, whether that's disease spread,
		transit ridership, or how corporate language shifts during a financial crisis. Most of my
		work sits at the intersection of applied math, data, and public policy.
	</p>

	<p class="mt-4 text-lg leading-relaxed text-slate-700 dark:text-stone-300">
		Most recently, I was an Industrial Research Intern at IncQuery and a RIPS-NSF Scholar at
		UCLA's Institute for Pure and Applied Mathematics (IPAM), where I built an automated
		verification pipeline for survey logic and presented the work to both engineers and a
		public research audience.
	</p>

	<p class="mt-4 text-lg leading-relaxed text-slate-700 dark:text-stone-300">
		I'm currently applying to <strong>software engineering & data roles</strong> and{' '}
		<strong>graduate programs</strong>. Take a look at my{' '}
		<a href="/projects/" class="text-blue-700 underline underline-offset-2 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">projects</a>{' '}
		or my <a href="/about/" class="text-blue-700 underline underline-offset-2 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">background</a>.
		{/* or <a href="/resume/" class="text-blue-700 underline underline-offset-2 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300">resume</a>. */}
	</p>

	<div class="mt-6 flex flex-wrap items-center gap-5">
		<a
			href="https://github.com/jtsalaja"
			aria-label="GitHub"
			class="text-slate-600 hover:text-blue-700 dark:text-stone-400 dark:hover:text-blue-400"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor">
				<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.84 1.238 1.84 1.238 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.605-2.665-.305-5.466-1.334-5.466-5.93 0-1.31.468-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12" />
			</svg>
		</a>
		<a
			href="https://www.linkedin.com/in/liz-tsalaja/"
			aria-label="LinkedIn"
			class="text-slate-600 hover:text-blue-700 dark:text-stone-400 dark:hover:text-blue-400"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor">
				<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z" />
			</svg>
		</a>
		<a
			href="mailto:jtsalaja@bates.edu"
			aria-label="Email"
			class="text-slate-600 hover:text-blue-700 dark:text-stone-400 dark:hover:text-blue-400"
		>
			<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-6 w-6">
				<rect x="3" y="5" width="18" height="14" rx="2" />
				<path d="m4 6 8 7 8-7" />
			</svg>
		</a>
	</div>
</BaseLayout>
