---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Resume">
	<div class="flex items-baseline justify-between">
		<h1 class="font-display text-4xl font-medium tracking-tight">Resume</h1>
		<a
			href="/resume.pdf"
			download
			class="text-sm text-blue-700 underline underline-offset-2 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300"
		>
			Download PDF &darr;
		</a>
	</div>
	<div class="mt-8 aspect-[8.5/11] w-full border border-stone-200 dark:border-stone-800">
		<iframe src="/resume.pdf" title="Resume preview" class="h-full w-full"></iframe>
	</div>
</BaseLayout>
