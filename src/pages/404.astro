---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found">
	<div class="flex flex-col items-start py-12">
		<p class="font-display text-7xl font-medium text-amber-800 dark:text-amber-400">404</p>
		<h1 class="mt-4 text-2xl font-semibold tracking-tight text-slate-900 dark:text-stone-100">
			This route doesn't exist.
		</h1>
		<p class="mt-3 max-w-md text-slate-600 dark:text-stone-400">
			Even a fare-free transit model can't get you to a page that was never built. You've
			transitioned into an unreachable state. No ridership here.
		</p>
		<a
			href="/"
			class="mt-8 text-amber-800 underline underline-offset-2 hover:text-amber-900 dark:text-amber-400 dark:hover:text-amber-300"
		>
			Back to the home route
		</a>
	</div>
</BaseLayout>
