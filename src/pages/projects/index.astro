---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort((a, b) => {
	const orderA = a.data.order ?? Infinity;
	const orderB = b.data.order ?? Infinity;
	if (orderA !== orderB) return orderA - orderB;
	return b.data.date.valueOf() - a.data.date.valueOf();
});
---

<BaseLayout title="Projects" description="Research and software projects by Liz Tsalaja.">
	<h1 class="font-display text-4xl font-medium tracking-tight">Projects</h1>
	<p class="mt-3 text-slate-600 dark:text-stone-400">A mix of applied math, data science, and research work.</p>
	<div class="mt-10 divide-y divide-stone-200 dark:divide-stone-800">
		{projects.map((project) => (
			<a
				href={`/projects/${project.id}/`}
				class="group block py-7 first:pt-0"
			>
				<p class="font-display text-2xl font-medium text-slate-900 group-hover:text-blue-700 dark:text-stone-100 dark:group-hover:text-blue-400">
					{project.data.title}
					{project.data.featured && <span class="ml-2 align-middle text-sm font-sans italic font-normal text-slate-400 dark:text-stone-500">featured</span>}
					{project.data.pdfUrl && <span class="ml-2 align-middle text-sm font-sans italic font-normal text-slate-400 dark:text-stone-500">paper (PDF)</span>}
				</p>
				<p class="mt-2 max-w-2xl text-slate-600 dark:text-stone-400">{project.data.description}</p>
				<p class="mt-2 text-sm italic text-slate-400 dark:text-stone-500">{project.data.stack.join(' · ')}</p>
			</a>
		))}
	</div>
</BaseLayout>
