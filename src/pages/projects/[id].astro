---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.description}>
	<a href="/projects/" class="text-sm text-slate-500 hover:text-blue-700 dark:text-stone-500 dark:hover:text-blue-400">&larr; Projects</a>
	<h1 class="mt-4 font-display text-4xl font-medium tracking-tight">{project.data.title}</h1>
	<p class="mt-3 text-sm italic text-slate-400 dark:text-stone-500">{project.data.stack.join(' · ')}</p>
	<article class="prose prose-slate mt-8 max-w-none dark:prose-invert">
		<Content />
	</article>

	{project.data.pdfUrl && (
		<p class="mt-6">
			<a
				href={project.data.pdfUrl}
				download
				class="text-blue-700 underline underline-offset-2 hover:text-blue-800 dark:text-blue-400 dark:hover:text-blue-300"
			>
				Read the full paper (PDF) &darr;
			</a>
		</p>
	)}
</BaseLayout>
