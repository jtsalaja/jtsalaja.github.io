---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
	const projects = await getCollection('projects');
	return projects.map((project) => ({
		params: { id: project.id },
		props: { project },
	}));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout title={project.data.title} description={project.data.description}>
	<a href="/projects/" class="text-sm text-slate-500 hover:text-amber-800 dark:text-stone-500 dark:hover:text-amber-400">&larr; Projects</a>
	<h1 class="mt-4 font-display text-4xl font-medium tracking-tight">{project.data.title}</h1>
	<p class="mt-3 text-sm italic text-slate-400 dark:text-stone-500">{project.data.stack.join(' · ')}</p>
	<div class="mt-4 flex gap-4 text-sm">
		{project.data.repoUrl && (
			<a href={project.data.repoUrl} class="text-amber-800 underline underline-offset-2 hover:text-amber-900 dark:text-amber-400 dark:hover:text-amber-300">Code</a>
		)}
		{project.data.demoUrl && (
			<a href={project.data.demoUrl} class="text-amber-800 underline underline-offset-2 hover:text-amber-900 dark:text-amber-400 dark:hover:text-amber-300">Live demo</a>
		)}
	</div>
	<article class="prose prose-slate mt-8 max-w-none dark:prose-invert">
		<Content />
	</article>
</BaseLayout>
